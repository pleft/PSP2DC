+    bool comp;              // this PSP knows the companion's messages (protocol 7)
+    bool comp_sent;         // the transfer in flight carries companion bytes
+    bool comp_reset;        // a session began: the PSP is told before its first bytes
     uint32_t sync_ms, status_ms, input_ms;
     uint32_t inputs, bad;   // counters, for the log
     uint16_t stream_len;
@@ -171,6 +175,9 @@ static void message(uint8_t addr, psp2dc_dev_t *d, uint8_t type, const uint8_t *
         submit(addr, d, &in);
         d->inputs++;
         d->input_ms = platform_time_ms();
+#ifdef CONFIG_VMU
+        if (d->silent && d->comp) { vmu_companion_link(true); d->comp_reset = true; }   // back after a silence: a new session
+#endif
         d->silent = false;
     } else if (type == PSP2DC_MSG_KEYBOARD && len == sizeof(Psp2dcKeyboard)) {
         Psp2dcKeyboard k;
@@ -181,6 +188,12 @@ static void message(uint8_t addr, psp2dc_dev_t *d, uint8_t type, const uint8_t *
         d->state_due = true;
         d->keeper = false;          // nothing goes to it before it says what it wants
 #ifdef CONFIG_VMU
+        d->comp = payload[0] >= 7;
+        vmu_companion_link(false);  // the companion starts over with each hello
+        vmu_companion_link(d->comp);
+        d->comp_reset = d->comp;
+    } else if (type == PSP2DC_MSG_COMP_EVENT) {
+        if (d->comp && len) vmu_companion_put(payload, len);   // (no room: dropped, the Dreamcast is not asking)
     } else if (type == PSP2DC_MSG_CARD_SEND && len >= 1) {
         if (card_loaded) {
             if (payload[0]) vmu_card_mark_all_dirty();
@@ -307,6 +320,13 @@ static uint16_t next_out(psp2dc_dev_t *d, uint32_t now)
             st.maple_max_us = m[7] > 0xffff ? 0xffff : (uint16_t)m[7];
         }
         dreamcast_keyboard_status(&st.kbd_mode, &st.kbd_leds, &st.kbd_reads);
+        {
+            uint32_t c[4];
+            vmu_companion_stats(c);
+            st.comp_cmds = (uint16_t)c[0];
+            st.comp_agains = (uint16_t)c[1];
+            st.comp_bytes = c[2];
+        }
 #endif
         d->status_ms = now;
         return put_msg(d->tx, PSP2DC_MSG_STATUS, &st, sizeof(st));
@@ -330,6 +350,45 @@ static uint16_t next_out(psp2dc_dev_t *d, uint32_t now)
     return 0;
 }
 
+// The companion's bytes for the PSP, after whatever else this transfer
+// carries: as many COMP_DATA messages as fit. A transfer must not end on a
+// full packet (the PSP's read would wait for more): an empty message follows
+// one that would.
+static uint16_t comp_append(psp2dc_dev_t *d, uint16_t n)
+{
+    d->comp_sent = false;
+#ifdef CONFIG_VMU
+    if (!d->comp) return n;
+    if (d->comp_reset && n + 2 * PSP2DC_HEADER_LEN <= sizeof(d->tx)) {
+        n += put_msg(d->tx + n, PSP2DC_MSG_COMP_RESET, NULL, 0);
+        d->comp_reset = false;
+        d->comp_sent = true;
+    }
+    while (n + 2 * PSP2DC_HEADER_LEN + 1 <= sizeof(d->tx)) {   // (room kept for the empty message)
+        uint32_t max = sizeof(d->tx) - n - 2 * PSP2DC_HEADER_LEN;
+        uint32_t got = vmu_companion_take(d->tx + n + PSP2DC_HEADER_LEN, max > 255 ? 255 : max);
+        if (!got) break;
+        n += put_msg(d->tx + n, PSP2DC_MSG_COMP_DATA, NULL, (uint8_t)got);
+        d->comp_sent = true;
+        if (got < 255) break;
+    }
+    if (d->comp_sent && n % PSP2DC_USB_PACKET_FS == 0) n += put_msg(d->tx + n, PSP2DC_MSG_COMP_DATA, NULL, 0);
+#endif
+    return n;
+}
+// Companion bytes that did not reach the PSP: its stream has a hole, so the
+// session changes and both ends start over.
+static void comp_lost(psp2dc_dev_t *d)
+{
+#ifdef CONFIG_VMU
+    if (!d->comp_sent) return;
+    d->comp_sent = false;
+    vmu_companion_link(false);
+    vmu_companion_link(d->comp);
+    d->comp_reset = d->comp;
+#endif
+}
+
 void psp2dc_host_task(void)
 {
     psp2dc_dev_t *d = &the_dev;
@@ -339,6 +398,9 @@ void psp2dc_host_task(void)
