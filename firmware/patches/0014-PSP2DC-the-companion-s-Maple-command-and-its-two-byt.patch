+#endif
     printf("[psp2dc] PSP %u: gone (%lu inputs, %lu bad bytes)\n", addr,
            (unsigned long)d->inputs, (unsigned long)d->bad);
     memset(d, 0, sizeof(*d));
@@ -448,6 +514,7 @@ static bool psp2dc_xfer(uint8_t addr, uint8_t ep, xfer_result_t result, uint32_t
         if (result == XFER_RESULT_SUCCESS) received(addr, d, len);
     } else if (ep == d->ep_out) {
         if (result != XFER_RESULT_SUCCESS) {
+            comp_lost(d);
