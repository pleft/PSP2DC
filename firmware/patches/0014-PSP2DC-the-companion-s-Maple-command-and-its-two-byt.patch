diff --git a/src/native/device/dreamcast/vmu.c b/src/native/device/dreamcast/vmu.c
index 9a256908..71c9a94b 100644
--- a/src/native/device/dreamcast/vmu.c
+++ b/src/native/device/dreamcast/vmu.c
@@ -11,6 +11,7 @@
 #include <stdio.h>
 
 #ifdef CONFIG_PSP2DC
+#include "psp2dc_protocol.h"
 #define PSP2DC_VMU_ID "USB RP2040 EMU  "   /* 16 characters, as openMenu compares them */
 #endif
 
@@ -348,6 +349,133 @@ bool vmu_lcd_take(uint8_t out[VMU_LCD_BYTES]) {
