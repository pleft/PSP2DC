         keys_let_go();
+#ifdef CONFIG_VMU
+        vmu_companion_link(false);
+#endif
         d->silent = true;
     }
     if (d->busy) return;
@@ -357,11 +419,12 @@ void psp2dc_host_task(void)
         return;
     }
     // RUNNING: one thing that is waiting goes out, then the next read
-    uint16_t n = next_out(d, now);
+    uint16_t n = comp_append(d, next_out(d, now));
     if (n && transfer(d->addr, d->ep_out, d->tx, n)) {
         d->busy = true;
         return;
     }
+    comp_lost(d);
 #ifdef CONFIG_VMU
