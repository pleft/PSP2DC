+
+#ifdef CONFIG_PSP2DC
+// ---- The companion (vmu.h) ----
+// Two queues of bytes, each with one side putting and the other taking, so
+// neither needs a lock: `put` is written only by the side that puts, `got`
+// only by the side that takes, both counting on without wrapping.
+#define COMP_Q_SIZE 4096u   // a power of two
+typedef struct {
+    uint8_t buf[COMP_Q_SIZE] __attribute__((aligned(4)));
+    volatile uint32_t put, got;
+} CompQueue;
+static CompQueue comp_psp;   // towards the PSP: the Maple side puts, Core 0 takes
+static CompQueue comp_dc;    // towards the Dreamcast: Core 0 puts, the Maple side takes
+static volatile bool    comp_link;      // a PSP is there
+static volatile uint8_t comp_session;   // +1 each time its link opens
+static uint8_t          comp_session_seen;   // the Maple side's
+static uint8_t          comp_seq_taken;      // the last SEND whose data was taken (0: none since HELLO)
+static volatile uint32_t comp_cmds, comp_agains, comp_bytes_in, comp_bytes_out;
+
+static struct __attribute__((packed, aligned(4))) {
+    uint32_t BitPairsMinus1;
+    uint8_t  Command; uint8_t Destination; uint8_t Origin; uint8_t NumWords;
+    uint32_t Func;
+    Psp2dcCompReply Reply;
+    uint8_t  Data[PSP2DC_COMP_DATA_MAX + 4];   // and the CRC after them
+} comp_pkt;
+static VmuAckPkt comp_again_pkt;
+static const void *comp_send = &comp_again_pkt;
+static uint32_t comp_send_words = sizeof(comp_again_pkt) / 4;
+
+static void __not_in_flash_func(comp_q_write)(CompQueue *q, const uint8_t *src, uint32_t n)   // (room: the caller's)
+{
+    uint32_t at = q->put & (COMP_Q_SIZE - 1), first = COMP_Q_SIZE - at;
+    if (first > n) first = n;
+    vmu_ram_copy(q->buf + at, src, first);
+    vmu_ram_copy(q->buf, src + first, n - first);
+    q->put += n;
+}
+static uint32_t __not_in_flash_func(comp_q_read)(CompQueue *q, uint8_t *dst, uint32_t max)
+{
+    uint32_t n = q->put - q->got, at = q->got & (COMP_Q_SIZE - 1), first = COMP_Q_SIZE - at;
+    if (n > max) n = max;
+    if (first > n) first = n;
+    vmu_ram_copy(dst, q->buf + at, first);
+    vmu_ram_copy(dst + first, q->buf, n - first);
+    q->got += n;
+    return n;
+}
+
+void __not_in_flash_func(vmu_handle_companion)(const uint32_t *pkt, uint32_t num_words)
+{
+    const uint8_t *req = (const uint8_t *)&pkt[1];   // Psp2dcCompRequest, then its data
+    uint8_t op = 0xFF, seq = 0, status = PSP2DC_COMP_OK, session = comp_session;
+    uint32_t len = 0, n = 0, words, room;
+    comp_cmds++;
+    if (num_words >= 2) { op = req[0]; seq = req[1]; len = req[2] | (uint32_t)req[3] << 8; }
+    if (session != comp_session_seen) {   // the PSP's link opened again: what it sent before is stale
+        comp_dc.got = comp_dc.put;
+        comp_session_seen = session;
+    }
+    if (op > PSP2DC_COMP_OP_POLL || len > PSP2DC_COMP_DATA_MAX || len > (num_words - 2) * 4) {
+        status = PSP2DC_COMP_BAD;
+    } else if (!comp_link) {
+        status = PSP2DC_COMP_NO_PSP;
+    } else if (op == PSP2DC_COMP_OP_SEND) {
+        if (COMP_Q_SIZE - (comp_psp.put - comp_psp.got) < len) {   // no room yet: "again", resent at the next vblank
+            VmuAckPkt *a = &comp_again_pkt;
+            comp_agains++;
+            a->BitPairsMinus1 = (sizeof(*a) - 7) * 4 - 1; a->Command = 0xFC;
+            a->Destination = 0; a->Origin = vmu_port_addr; a->NumWords = 0;
+            a->CRC = CalcCRC((uint32_t *)&a->Command, 1);
+            comp_send = a; comp_send_words = sizeof(*a) / 4;
+            return;
+        }
+        if (seq != comp_seq_taken) {   // (the same again: its reply was lost, the data is here already)
+            comp_q_write(&comp_psp, req + sizeof(Psp2dcCompRequest), len);
+            comp_bytes_in += len;
+            comp_seq_taken = seq;
+        }
+    }
+    if (op == PSP2DC_COMP_OP_HELLO) {
+        static const char magic[6] = { 'P', 'S', 'P', '2', 'D', 'C' };
+        for (n = 0; n < 6; n++) comp_pkt.Data[n] = (uint8_t)magic[n];
+        comp_pkt.Data[n++] = PSP2DC_PROTOCOL_VERSION;
+        comp_pkt.Data[n++] = 0;
+        comp_seq_taken = 0;
+    } else if (status == PSP2DC_COMP_OK) {
+        n = comp_q_read(&comp_dc, comp_pkt.Data, PSP2DC_COMP_DATA_MAX);
+        comp_bytes_out += n;
+    }
+    room = COMP_Q_SIZE - (comp_psp.put - comp_psp.got);
+    comp_pkt.Reply.status = status;
+    comp_pkt.Reply.session = session;
+    comp_pkt.Reply.seq = seq;
+    comp_pkt.Reply.reserved = 0;
+    comp_pkt.Reply.room = (uint16_t)(room > 0xFFFF ? 0xFFFF : room);
+    comp_pkt.Reply.len = (uint16_t)n;
+    while (n & 3) comp_pkt.Data[n++] = 0;
+    words = 1 + sizeof(Psp2dcCompReply) / 4 + n / 4;   // the function word, the reply, its data
+    comp_pkt.Command = CMD_RESPOND_DATA_TRANSFER;
+    comp_pkt.Destination = 0; comp_pkt.Origin = vmu_port_addr;
+    comp_pkt.NumWords = (uint8_t)words;
+    comp_pkt.Func = __builtin_bswap32(FUNC_MEMORY);
+    comp_pkt.BitPairsMinus1 = (words * 4 + 5) * 4 - 1;   // header, payload and the CRC's byte, in pairs of bits
+    ((uint32_t *)&comp_pkt.Func)[words] = CalcCRC((uint32_t *)&comp_pkt.Command, words + 1);
+    comp_send = &comp_pkt; comp_send_words = words + 3;
+}
+const void* __not_in_flash_func(vmu_get_companion_packet)(uint32_t *sz) { *sz = comp_send_words; return comp_send; }
+
+void vmu_companion_link(bool up)
+{
+    if (up == comp_link) return;
+    if (up) { comp_psp.got = comp_psp.put; comp_session++; }
+    comp_link = up;
+}
+uint32_t vmu_companion_take(uint8_t *out, uint32_t max) { return comp_q_read(&comp_psp, out, max); }
+bool vmu_companion_put(const uint8_t *data, uint32_t len)
+{
+    if (COMP_Q_SIZE - (comp_dc.put - comp_dc.got) < len) return false;
+    comp_q_write(&comp_dc, data, len);
+    return true;
+}
+void vmu_companion_stats(uint32_t out[4])
+{
+    out[0] = comp_cmds; out[1] = comp_agains; out[2] = comp_bytes_in; out[3] = comp_bytes_out;
+}
+#endif
 const void* __not_in_flash_func(vmu_get_ack_packet)(uint32_t *sz)             { *sz=sizeof(vmu_ack_pkt)/4;       return &vmu_ack_pkt; }
 
 const void* __not_in_flash_func(vmu_handle_block_read)(const uint32_t *pkt, uint32_t *sz) {
diff --git a/src/native/device/dreamcast/vmu.h b/src/native/device/dreamcast/vmu.h
index b1d95b0b..ff54576f 100644
--- a/src/native/device/dreamcast/vmu.h
+++ b/src/native/device/dreamcast/vmu.h
@@ -86,6 +86,23 @@ bool vmu_lcd_take(uint8_t out[VMU_LCD_BYTES]);
 void vmu_handle_game_id(const uint32_t *packet_data, uint32_t num_words);
 bool vmu_game_id_take(char id[12], char name[128]);
 
+#ifdef CONFIG_PSP2DC
+// The companion (psp2dc_protocol.h): a Dreamcast program's command to the
+// memory card unit, answered at once from two byte queues, one towards the
+// PSP and one towards the Dreamcast. The Maple side builds the reply (a data
+// transfer, or "again" when a SEND has no room yet); Core 0 moves the bytes
+// between the queues and the PSP.
+void vmu_handle_companion(const uint32_t *packet_data, uint32_t num_words);
+const void *vmu_get_companion_packet(uint32_t *size_words);
+// Core 0. The PSP's link opened (what waited is dropped, the session changes)
+// or went; bytes for the PSP taken (how many); bytes from the PSP put (false:
+// no room, nothing put); counts: commands, "again" answers, bytes in, bytes out.
+void vmu_companion_link(bool up);
+uint32_t vmu_companion_take(uint8_t *out, uint32_t max);
+bool vmu_companion_put(const uint8_t *data, uint32_t len);
+void vmu_companion_stats(uint32_t out[4]);
+#endif
+
 // The card as a whole, for a keeper outside the adapter (PSP2DC: the PSP's
 // Memory Stick). Core 0. A block is VMU_BLOCK_SIZE bytes in VMU_CARD_PARTS parts.
 #define VMU_CARD_PARTS      4
