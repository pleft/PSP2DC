From 1cdaeb7934c6e14c54e7e5bf50ef946f859e5c49 Mon Sep 17 00:00:00 2001
From: pleft <elefasgr@gmail.com>
Date: Sun, 22 Nov 2026 21:13:40 +0200
Subject: [PATCH 17/17] PSP2DC: the gap from a frame's end to the next start,
 for frames received whole and broken off

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../device/dreamcast/dreamcast_device.c       | 32 ++++++++++++++++++-
 src/usb/usbh/psp2dc/psp2dc_host.c             |  8 +++++
 2 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/src/native/device/dreamcast/dreamcast_device.c b/src/native/device/dreamcast/dreamcast_device.c
index 63d51907..0642c13c 100644
--- a/src/native/device/dreamcast/dreamcast_device.c
+++ b/src/native/device/dreamcast/dreamcast_device.c
@@ -1176,6 +1176,12 @@ static void __not_in_flash_func(maple_note_unanswered)(uint32_t size)
 // line error or a new start, and the bytes the last one had reached; the
 // longest frame received whole since the last call.
 static volatile uint32_t maple_broken, maple_broken_at, maple_longest;
+// From a frame's end to the next start (us): the shortest before a frame
+// received whole, and before one of 200 bytes or more, since the last call;
+// and before the last frame broken off.
+#define GAP_NONE 0xFFFFu
+static volatile uint32_t gap_good_min = GAP_NONE, gap_long_min = GAP_NONE, gap_broken = GAP_NONE;
+static volatile uint32_t raw_gap;
 static uint32_t maple_stalls;
 
 // The receiver's last bytes and states, and a copy of them around the first
@@ -1187,13 +1193,14 @@ static uint32_t maple_stalls;
 static uint8_t raw_ring[RAW_N], raw_ring_state[RAW_N];
 static uint8_t raw_copy[RAW_N], raw_copy_state[RAW_N];
 static volatile uint32_t raw_stage;
-static uint8_t raw_kind, raw_at;
+static volatile uint8_t raw_kind, raw_at;
 static uint32_t raw_sent_ms;
 
 static void __not_in_flash_func(raw_note_broken)(uint32_t kind, uint32_t at)
 {
     if (raw_stage != 0) return;
     raw_kind = (uint8_t)kind;
+    raw_gap = gap_broken;
     raw_at = at > 255 ? 255 : (uint8_t)at;
     raw_stage = 1;
 }
@@ -1209,6 +1216,8 @@ bool dreamcast_maple_raw_take(uint8_t *out, uint32_t now_ms)
     out[3] = 0;
     memcpy(out + 4, raw_copy, RAW_N);
     memcpy(out + 4 + RAW_N, raw_copy_state, RAW_N);
+    out[4 + 2 * RAW_N] = (uint8_t)raw_gap;
+    out[5 + 2 * RAW_N] = (uint8_t)(raw_gap >> 8);
     raw_sent_ms = now_ms;
     raw_stage = 3;
     return true;
@@ -1218,6 +1227,14 @@ bool dreamcast_maple_raw_take(uint8_t *out, uint32_t now_ms)
 // broke, line errors, the longest whole frame in the last second, and the
 // seconds in which the receiver's FIFO ran full (its state machines stalled,
 // transitions missed).
+void dreamcast_maple_gaps(uint32_t out[3])
+{
+    out[0] = gap_good_min;
+    out[1] = gap_long_min;
+    out[2] = gap_broken;
+    gap_good_min = gap_long_min = GAP_NONE;
+}
+
 void dreamcast_maple_rx_counts(uint32_t out[5])
 {
     const uint32_t stall = 7u << PIO_FDEBUG_RXSTALL_LSB;   // the receiver's three state machines
@@ -1261,6 +1278,7 @@ static void __no_inline_not_in_flash_func(core1_rx_task)(void)
 #ifdef CONFIG_PSP2DC
     bool InFrame = false;  // a start seen, its end not yet
     uint32_t RawIndex = 0, RawPost = 0;
+    uint32_t EndTime = 0, Gap = GAP_NONE;  // the last end seen; from it to this frame's start
 #endif
 
     core1_state = 1;  // Building tables
@@ -1317,6 +1335,7 @@ static void __no_inline_not_in_flash_func(core1_rx_task)(void)
             rx_errors_count++;
 #ifdef CONFIG_PSP2DC
             if (InFrame) {  // the frame is lost: the receiver is back to waiting for a start
+                gap_broken = Gap;
                 maple_broken++;
                 maple_broken_at = Offset - StartOfPacket;
                 raw_note_broken(1, Offset - StartOfPacket);
@@ -1328,7 +1347,12 @@ static void __no_inline_not_in_flash_func(core1_rx_task)(void)
         if (M.Reset) {
             rx_resets_count++;
 #ifdef CONFIG_PSP2DC
+            {
+                uint32_t g = time_us_32() - EndTime;
+                Gap = g > GAP_NONE - 1 ? GAP_NONE - 1 : g;
+            }
             if (InFrame) {  // a new start before the last frame's end
+                gap_broken = Gap;
                 maple_broken++;
                 maple_broken_at = Offset - StartOfPacket;
                 raw_note_broken(2, Offset - StartOfPacket);
@@ -1353,11 +1377,17 @@ static void __no_inline_not_in_flash_func(core1_rx_task)(void)
             rx_ends_count++;
 #ifdef CONFIG_PSP2DC
             InFrame = false;
+            EndTime = time_us_32();
 #endif
             if (XOR == 0) {  // CRC valid
                 rx_crc_ok++;
 #ifdef CONFIG_PSP2DC
                 if (Offset - StartOfPacket > maple_longest) maple_longest = Offset - StartOfPacket;
+                // (only the Dreamcast's: to a peripheral; the header's Destination, before its swap)
+                if (RxBuffer[(StartOfPacket + 2) & (RX_BUFFER_SIZE - 1)] & ADDRESS_PERIPHERAL_MASK) {
+                    if (Gap < gap_good_min) gap_good_min = Gap;
+                    if (Offset - StartOfPacket >= 200 && Gap < gap_long_min) gap_long_min = Gap;
+                }
 #endif
 
 #ifdef CONFIG_DC_CORE1_TX
diff --git a/src/usb/usbh/psp2dc/psp2dc_host.c b/src/usb/usbh/psp2dc/psp2dc_host.c
index 2f582e89..a36b29a9 100644
--- a/src/usb/usbh/psp2dc/psp2dc_host.c
+++ b/src/usb/usbh/psp2dc/psp2dc_host.c
@@ -334,6 +334,14 @@ static uint16_t next_out(psp2dc_dev_t *d, uint32_t now)
             st.maple_longest = (uint16_t)r[3];
             st.maple_stalls = (uint16_t)r[4];
         }
+        {
+            extern void dreamcast_maple_gaps(uint32_t out[3]);
+            uint32_t g[3];
+            dreamcast_maple_gaps(g);
+            st.gap_good_min = (uint16_t)g[0];
+            st.gap_long_min = (uint16_t)g[1];
+            st.gap_broken = (uint16_t)g[2];
+        }
         dreamcast_keyboard_status(&st.kbd_mode, &st.kbd_leds, &st.kbd_reads);
         {
             uint32_t c[4];
-- 
