From 6ca43115f8e0b9df1fd7454c2a23be55b14227fb Mon Sep 17 00:00:00 2001
From: pleft <elefasgr@gmail.com>
Date: Thu, 26 Nov 2026 22:23:06 +0200
Subject: [PATCH 19/19] PSP2DC: the light stops blinking once the card's
 changes are on the PSP

Nothing cleared the write-pending flag in this build, so the light blinked
blue from the first save until power off.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/native/device/dreamcast/dreamcast_device.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/native/device/dreamcast/dreamcast_device.c b/src/native/device/dreamcast/dreamcast_device.c
index bd0ed364..bc33f41f 100644
--- a/src/native/device/dreamcast/dreamcast_device.c
+++ b/src/native/device/dreamcast/dreamcast_device.c
@@ -1716,6 +1716,10 @@ void dreamcast_task(void)
         vmu_led_timeout_ms = 1;
     }
 
+#ifdef CONFIG_PSP2DC
+    // PSP2DC keeps the card on the PSP: nothing is pending once every changed block has gone there
+    if (vmu_dirty_flag && vmu_card_dirty_count() == 0) vmu_dirty_flag = false;
+#endif
     if (vmu_dirty_flag) {
         // Write pending flush — blink blue until flushed
         vmu_read_flash_ms = 0;  // Cancel any read flash
-- 
