+static uint16_t put_msg(uint8_t *at, uint8_t type, const void *payload, uint8_t len)
+{
+    at[0] = PSP2DC_MAGIC0; at[1] = PSP2DC_MAGIC1; at[2] = type; at[3] = len;
+    if (payload) memcpy(at + PSP2DC_HEADER_LEN, payload, len);
+    return (uint16_t)(PSP2DC_HEADER_LEN + len);
+}
+
 static void submit(uint8_t addr, psp2dc_dev_t *d, const Psp2dcInput *in)
 {
     static const struct { uint16_t psp; uint32_t jp; } map[] = {
@@ -100,6 +128,37 @@ static void submit(uint8_t addr, psp2dc_dev_t *d, const Psp2dcInput *in)
     d->submitted = true;
 }
 
+static void message(uint8_t addr, psp2dc_dev_t *d, uint8_t type, const uint8_t *payload, uint8_t len)
+{
+    if (type == PSP2DC_MSG_INPUT && len == sizeof(Psp2dcInput)) {
+        Psp2dcInput in;
+        memcpy(&in, payload, sizeof(in));
+        submit(addr, d, &in);
+        d->inputs++;
+        d->input_ms = platform_time_ms();
+        d->silent = false;
+    } else if (type == PSP2DC_MSG_HELLO && len >= 1) {
+        printf("[psp2dc] PSP %u: hello, protocol %u\n", addr, payload[0]);
+        d->state_due = true;
+        d->keeper = false;
+#ifdef CONFIG_VMU
+        if (card_loaded) {          // the adapter's copy is the one that counts: all of it to this PSP
+            vmu_card_mark_all_dirty();
+            d->keeper = true;
+        }
+    } else if (type == PSP2DC_MSG_CARD_PART && len == sizeof(Psp2dcCardPart)) {
+        if (!card_loaded) vmu_card_set_part(payload[0], payload[1], payload + 2);   // (never once a game can write)
+    } else if (type == PSP2DC_MSG_CARD_DONE && len == sizeof(Psp2dcCardDone)) {
+        if (!card_loaded) {
+            if (!payload[0]) vmu_card_mark_all_dirty();   // no file there: the formatted card is the PSP's to keep
+            card_loaded = true;
+            printf("[psp2dc] PSP %u: memory card %s\n", addr, payload[0] ? "received" : "new");
+        }
+        d->keeper = true;
+#endif
+    }
+}
