 5 files changed, 227 insertions(+), 80 deletions(-)

diff --git a/src/apps/usb2dc/usb2dc_config.h b/src/apps/usb2dc/usb2dc_config.h
index 090db511..6a4de414 100644
--- a/src/apps/usb2dc/usb2dc_config.h
+++ b/src/apps/usb2dc/usb2dc_config.h
@@ -40,9 +40,19 @@
 
 // Dreamcast = 4 controller ports, and the 128 KB VMU image is RAM-tight, so
 // right-size the USB host arrays below the global hub/device caps.
+#ifdef CONFIG_PSP2DC
+// The SuperPico with a PSP as its controller: the one USB port is the PSP's, so
+// no hub and one device. The RAM that frees is what the memory card (128 KB)
+// and its transfer buffers need.
+#define CFG_TUH_HUB             0
+#define CFG_TUH_DEVICE_MAX      1
+#define MAX_DEVICES             2   // floor: CFG_TUH_DEVICE_MAX + CFG_TUH_HUB + 1
+#define MAX_PLAYERS_PER_OUTPUT  4
+#else
 #define CFG_TUH_HUB             1   // one hub covers 4 ports (no cascading)
 #define CFG_TUH_DEVICE_MAX      5   // 4 ports + margin
 #define MAX_DEVICES             7   // floor: CFG_TUH_DEVICE_MAX + CFG_TUH_HUB + 1
 #define MAX_PLAYERS_PER_OUTPUT  4   // 4 ports; save RAM vs the global 8
+#endif
 
 #endif // USB2DC_CONFIG_H
diff --git a/src/native/device/dreamcast/dreamcast_device.c b/src/native/device/dreamcast/dreamcast_device.c
index 335af57d..73231501 100644
--- a/src/native/device/dreamcast/dreamcast_device.c
+++ b/src/native/device/dreamcast/dreamcast_device.c
@@ -1373,7 +1373,15 @@ void dreamcast_task(void)
     // Controller enumerates cleanly first, then VMU+PuruPuru are added
     // SD card load also deferred here to avoid blocking Maple Bus enumeration at boot
 #ifdef CONFIG_VMU
+#ifdef CONFIG_PSP2DC
+    // The card is the PSP's file: nothing to show the Dreamcast until the PSP
+    // has sent it (or said it has none), or a game could save onto the empty
+    // card of a PSP that connects a moment later with its own.
+    extern bool psp2dc_card_ready(void);
+    if (!vmu_enabled && time_us_32() > vmu_enable_time && psp2dc_card_ready()) {
+#else
     if (!vmu_enabled && time_us_32() > vmu_enable_time) {
+#endif
         // QSPI is always available so VMU is always advertised.
         // vmu_sd_load() also sets up SD as backup if a card is present.
         vmu_sd_load();
diff --git a/src/native/device/dreamcast/vmu.c b/src/native/device/dreamcast/vmu.c
index a99deaac..87f542dd 100644
--- a/src/native/device/dreamcast/vmu.c
+++ b/src/native/device/dreamcast/vmu.c
@@ -100,6 +100,10 @@ static uint8_t         vmu_lcd[VMU_LCD_BYTES] __attribute__((aligned(4)));
 static volatile uint32_t vmu_lcd_seq;             // +1 a screen written (Core 1)
 static uint32_t        vmu_lcd_taken;             // the last one Core 0 took
 static volatile uint32_t vmu_lcd_media, vmu_lcd_writes, vmu_lcd_last_words, vmu_lcd_last_addr;
+// A byte a block, not bits: Core 1 sets and Core 0 clears, and a byte store is
+// one instruction where setting a bit in a word is read, change, write.
+static volatile uint8_t vmu_block_dirty[VMU_TOTAL_BLOCKS];
+static uint16_t        vmu_dirty_scan;            // Core 0: where the last search stopped
 
 static VmuInfoPkt      vmu_info_pkt;
 static VmuAllInfoPkt   vmu_all_info_pkt;
@@ -337,6 +341,7 @@ void __not_in_flash_func(vmu_handle_block_write)(const uint32_t *pkt, uint32_t n
 void __not_in_flash_func(vmu_handle_write_complete)(void) {
     if (write_block == 0xFFFF || write_phases == 0) return;
     vmu_ram_copy(vmu_ram + (uint32_t)write_block * VMU_BLOCK_SIZE, write_buf, VMU_BLOCK_SIZE);
+    vmu_block_dirty[write_block] = 1;
     write_block = 0xFFFF;
     write_phases = 0;
     vmu_status = VMU_STATUS_OK;
@@ -346,6 +351,40 @@ void __not_in_flash_func(vmu_handle_write_complete)(void) {
     vmu_activity_flag = true;
 }
 
+void vmu_card_set_part(uint8_t block, uint8_t part, const uint8_t *data) {
+    if (part >= VMU_CARD_PARTS) return;
+    memcpy(vmu_ram + (uint32_t)block * VMU_BLOCK_SIZE + part * VMU_CARD_PART_SIZE, data, VMU_CARD_PART_SIZE);
+}
+
+void vmu_card_get_part(uint8_t block, uint8_t part, uint8_t *out) {
+    if (part >= VMU_CARD_PARTS) return;
+    memcpy(out, vmu_ram + (uint32_t)block * VMU_BLOCK_SIZE + part * VMU_CARD_PART_SIZE, VMU_CARD_PART_SIZE);
+}
+
+void vmu_card_mark_all_dirty(void) { memset((void *)vmu_block_dirty, 1, sizeof(vmu_block_dirty)); }
+void vmu_card_mark_dirty(uint8_t block) { vmu_block_dirty[block] = 1; }
+
+// The mark comes off before the block is read: a write by Core 1 during the
+// read marks it again, and it is taken once more with what was written.
+bool vmu_card_take_dirty(uint8_t *block) {
+    for (unsigned i = 0; i < VMU_TOTAL_BLOCKS; i++) {
+        uint16_t b = (uint16_t)((vmu_dirty_scan + i) % VMU_TOTAL_BLOCKS);
+        if (vmu_block_dirty[b]) {
+            vmu_block_dirty[b] = 0;
+            vmu_dirty_scan = (uint16_t)((b + 1) % VMU_TOTAL_BLOCKS);
+            *block = (uint8_t)b;
+            return true;
+        }
+    }
+    return false;
+}
+
+uint32_t vmu_card_dirty_count(void) {
+    uint32_t n = 0;
+    for (unsigned i = 0; i < VMU_TOTAL_BLOCKS; i++) n += vmu_block_dirty[i];
+    return n;
+}
+
 void vmu_task(void) {
     // Flush dirty VMU RAM to active backend (QSPI + SD backup if available)
     vmu_storage_task();
diff --git a/src/native/device/dreamcast/vmu.h b/src/native/device/dreamcast/vmu.h
index 18dbd46f..df547c2b 100644
--- a/src/native/device/dreamcast/vmu.h
+++ b/src/native/device/dreamcast/vmu.h
@@ -80,6 +80,20 @@ void vmu_lcd_stats(vmu_lcd_stats_t *out);
 // Core 0: the screen, when it changed since the last call. True when copied.
 bool vmu_lcd_take(uint8_t out[VMU_LCD_BYTES]);
 
+// The card as a whole, for a keeper outside the adapter (PSP2DC: the PSP's
+// Memory Stick). Core 0. A block is VMU_BLOCK_SIZE bytes in VMU_CARD_PARTS parts.
+#define VMU_CARD_PARTS      4
+#define VMU_CARD_PART_SIZE  (VMU_BLOCK_SIZE / VMU_CARD_PARTS)
+// Put a part of the card in place. Only before the Dreamcast is shown the card.
+void vmu_card_set_part(uint8_t block, uint8_t part, const uint8_t *data);
+void vmu_card_get_part(uint8_t block, uint8_t part, uint8_t *out);
+// Blocks changed since they were last taken: every block a game writes is
+// marked (Core 1); vmu_card_take_dirty gives the next one and unmarks it.
+void vmu_card_mark_all_dirty(void);
+bool vmu_card_take_dirty(uint8_t *block);
+void vmu_card_mark_dirty(uint8_t block);
+uint32_t vmu_card_dirty_count(void);
+
 // Address and status
 uint8_t   vmu_get_address(void);
 VmuStatus vmu_get_status(void);
