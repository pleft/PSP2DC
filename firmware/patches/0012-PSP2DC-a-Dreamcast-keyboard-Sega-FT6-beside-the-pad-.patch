From 2ab32e86664c7e750176a039537020828736446b Mon Sep 17 00:00:00 2001
From: pleft <elefasgr@gmail.com>
Date: Wed, 18 Nov 2026 20:59:06 +0200
Subject: [PATCH 12/17] PSP2DC: a Dreamcast keyboard (Sega FT6), beside the pad
 or alone, typed on the PSP (protocol 6)

The PSP chooses the mode with a KEYBOARD message: off, one device with both
functions (41h, the VMU still in it), or a keyboard alone (40h). The keyboard
answers as Sega's FT6 spec (rev. 0.90) has it: US, 104 keys, its own LEDs;
Get Condition with the modifiers, the LEDs and six USB key codes; Set
Condition (the LEDs) with a reply. A change of mode is the device unplugged
for a second. The keys are let go when the PSP goes quiet or away. The status
carries the mode, the LEDs set and how often the keyboard was read.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../device/dreamcast/dreamcast_device.c       | 196 ++++++++++++++++++
 .../device/dreamcast/dreamcast_device.h       |   6 +
 src/usb/usbh/psp2dc/psp2dc_host.c             |  19 ++
 3 files changed, 221 insertions(+)

diff --git a/src/native/device/dreamcast/dreamcast_device.c b/src/native/device/dreamcast/dreamcast_device.c
index 371cfdd4..5c1f8e27 100644
--- a/src/native/device/dreamcast/dreamcast_device.c
+++ b/src/native/device/dreamcast/dreamcast_device.c
@@ -35,6 +35,9 @@
 #include "pico/stdlib.h"
 #include <string.h>
 #include <stdio.h>
+#ifdef CONFIG_PSP2DC
+#include "psp2dc_protocol.h"
+#endif
 
 // ============================================================================
 // PIO AND DMA CONFIGURATION
@@ -314,6 +317,10 @@ typedef enum {
     SEND_VMU_WRITE_COMPLETE_ACK, // WR_COMPLETE ACK — always fires, aborts any stuck DMA
     SEND_CONTROLLER_AND_VMU_INFO,
     SEND_CONTROLLER_AND_VMU_ALL_INFO,
+    SEND_KBD_INFO,              // PSP2DC: the keyboard's device info (with the pad, or alone)
+    SEND_KBD_ALL_INFO,
+    SEND_KBD_STATUS,            // its keys
+    SEND_KBD_ACK,               // its reply (the main device's address for the mode)
 } ESendState;
 
 static volatile ESendState NextPacketSend = SEND_NOTHING;
@@ -640,6 +647,173 @@ static void __not_in_flash_func(SendControllerStatus)(void)
     SendPacket((uint32_t *)pControllerPacket, sizeof(ControllerPacket) / sizeof(uint32_t));
 }
 
+#ifdef CONFIG_PSP2DC
+// ============================================================================
+// THE KEYBOARD (PSP2DC)
+// ============================================================================
+// As Sega's "Maple Bus 1.0 Function Type Specifications FT6: Keyboard" (rev.
+// 0.90) has it: function type 40h; its function definition block the bytes
+// KL (language: 02h US), KT (type: 05h, 104 keys), LD (LEDs: 0) and LDON
+// (80h: the keyboard keeps its own LEDs), the values flycast's emulated
+// keyboard gives; Get Condition answered with the function type and 8 bytes
+// (the modifier keys, the LEDs, six key codes); Set Condition (the host's
+// LEDs) answered with a reply. The PSP chooses the mode (Psp2dcKeyboard in
+// psp2dc_protocol.h): the keyboard beside the pad in one device (functions
+// 41h, the VMU still in it), or a keyboard alone. A change of mode is the
+// device unplugged for a second, so that the Dreamcast reads it again.
+// All of it runs on Core 0, as the replies do (CONFIG_DC_CORE1_TX is off).
+#define FUNC_KEYBOARD 0x40
+#define KBD_FUNC_DATA 0x02050080u   // KL KT LD LDON
+
+typedef struct __attribute__((packed)) {
+    uint32_t BitPairsMinus1;
+    PacketHeader Header;
+    uint32_t Func;
+    uint8_t Cond[8];
+    uint32_t CRC;
+} FKeyboardPacket;
+
+static uint8_t kbd_mode;                  // PSP2DC_KBD_*
+static uint8_t kbd_cond[8];               // the PSP's: modifiers, LEDs, keys
+static uint8_t kbd_leds_set;              // what the Dreamcast last set
+static uint32_t kbd_reads;                // Get Conditions for the keyboard
+static uint32_t kbd_unplugged_until;      // the device out until then (us); 0: in
+static FInfoPacket KbdInfoPacket;
+static FAllInfoPacket KbdAllInfoPacket;
+static FKeyboardPacket KbdPacket;
+
+static bool kbd_unplugged(void)
+{
+    if (!kbd_unplugged_until) return false;
+    if ((int32_t)(time_us_32() - kbd_unplugged_until) < 0) return true;
+    kbd_unplugged_until = 0;
+    return false;
+}
+
+// The main device's address byte: with the pad, the pad's sub-units (the VMU
+// once the card is in); a keyboard alone has none.
+static uint8_t kbd_origin(void)
+{
+    return kbd_mode == PSP2DC_KBD_ONLY ? ADDRESS_CONTROLLER : ADDRESS_CONTROLLER_AND_SUBS;
+}
+
+static void kbd_build(void)
+{
+    PacketDeviceInfo *i = &KbdInfoPacket.Info;
+    memset(i, 0, sizeof(*i));
+    if (kbd_mode == PSP2DC_KBD_PAD) {
+        // two functions: their blocks from the highest function bit down, as a
+        // VMU's (timer, LCD, then the card's)
+        i->Func = __builtin_bswap32(FUNC_KEYBOARD | FUNC_CONTROLLER);
+        i->FuncData[0] = __builtin_bswap32(KBD_FUNC_DATA);
+        i->FuncData[1] = __builtin_bswap32(0x000f06fe);   // the pad's (BuildInfoPacket)
+        memcpy(i->ProductName, "Dreamcast Controller          ", sizeof(i->ProductName));
+        i->StandbyPower = 430;
+        i->MaxPower = 500;
+    } else {
+        i->Func = __builtin_bswap32(FUNC_KEYBOARD);
+        i->FuncData[0] = __builtin_bswap32(KBD_FUNC_DATA);
+        memcpy(i->ProductName, "Keyboard                      ", sizeof(i->ProductName));
+        i->StandbyPower = 0x01AE;
+        i->MaxPower = 0x01F5;
+    }
+    i->AreaCode = -1;
+    i->ConnectorDirection = 0;
+    memcpy(i->ProductLicense, "Produced By or Under License From SEGA ENTERPRISES,LTD.     ", sizeof(i->ProductLicense));
+    KbdInfoPacket.BitPairsMinus1 = (sizeof(KbdInfoPacket) - 7) * 4 - 1;
+    KbdInfoPacket.Header.Command = CMD_RESPOND_DEVICE_STATUS;
+    KbdInfoPacket.Header.Destination = ADDRESS_DREAMCAST;
+    KbdInfoPacket.Header.NumWords = sizeof(KbdInfoPacket.Info) / sizeof(uint32_t);
+
+    memcpy(&KbdAllInfoPacket.Info, i, sizeof(*i));      // (the same fields first)
+    memset(KbdAllInfoPacket.Info.FreeDeviceStatus, ' ', sizeof(KbdAllInfoPacket.Info.FreeDeviceStatus));
+    memcpy(KbdAllInfoPacket.Info.FreeDeviceStatus, "Version 1.000,", 14);
+    KbdAllInfoPacket.BitPairsMinus1 = (sizeof(KbdAllInfoPacket) - 7) * 4 - 1;
+    KbdAllInfoPacket.Header.Command = CMD_RESPOND_ALL_DEVICE_STATUS;
+    KbdAllInfoPacket.Header.Destination = ADDRESS_DREAMCAST;
+    KbdAllInfoPacket.Header.NumWords = sizeof(KbdAllInfoPacket.Info) / sizeof(uint32_t);
+
+    KbdPacket.BitPairsMinus1 = (sizeof(KbdPacket) - 7) * 4 - 1;
+    KbdPacket.Header.Command = CMD_RESPOND_DATA_TRANSFER;
+    KbdPacket.Header.Destination = ADDRESS_DREAMCAST;
+    KbdPacket.Header.NumWords = (sizeof(KbdPacket.Func) + sizeof(KbdPacket.Cond)) / sizeof(uint32_t);
+    KbdPacket.Func = __builtin_bswap32(FUNC_KEYBOARD);
+}
+
+// a keyboard packet out, its address and check made now (the VMU comes and
+// goes in the pad's address)
+static void __not_in_flash_func(kbd_send)(void *pkt, uint32_t bytes, PacketHeader *h)
+{
+    h->Origin = kbd_origin();
+    h->Destination = ADDRESS_DREAMCAST;
+    *(uint32_t *)((uint8_t *)pkt + bytes - 4) = CalcCRC((uint32_t *)h, bytes / sizeof(uint32_t) - 2);
+    SendPacket((uint32_t *)pkt, bytes / sizeof(uint32_t));
+}
+
+static void __not_in_flash_func(kbd_reply)(ESendState what)
+{
+    switch (what) {
+    case SEND_KBD_INFO:     kbd_send(&KbdInfoPacket, sizeof(KbdInfoPacket), &KbdInfoPacket.Header); break;
+    case SEND_KBD_ALL_INFO: kbd_send(&KbdAllInfoPacket, sizeof(KbdAllInfoPacket), &KbdAllInfoPacket.Header); break;
+    case SEND_KBD_STATUS:
+        memcpy(KbdPacket.Cond, kbd_cond, sizeof(KbdPacket.Cond));
+        kbd_send(&KbdPacket, sizeof(KbdPacket), &KbdPacket.Header);
+        break;
+    case SEND_KBD_ACK:
+        if (kbd_mode == PSP2DC_KBD_ONLY) SendPacket((uint32_t *)&ACKPacket, sizeof(ACKPacket) / sizeof(uint32_t));
+        else SendPacket((uint32_t *)pACKPacket, sizeof(ACKPacket) / sizeof(uint32_t));
+        break;
+    default: break;
+    }
+}
+
+// a packet for the main device (0x20) while a keyboard is shown
+static bool __not_in_flash_func(kbd_consume)(const PacketHeader *h, const uint32_t *data)
+{
+    uint32_t func = h->NumWords >= 1 ? __builtin_bswap32(data[0]) : 0;
+    switch (h->Command) {
+    case CMD_RESET_DEVICE:       NextPacketSend = SEND_KBD_ACK; return true;
+    case CMD_DEVICE_REQUEST:     NextPacketSend = SEND_KBD_INFO; return true;
+    case CMD_ALL_STATUS_REQUEST: NextPacketSend = SEND_KBD_ALL_INFO; return true;
+    case CMD_GET_CONDITION:
+        if (func == FUNC_KEYBOARD) { kbd_reads++; NextPacketSend = SEND_KBD_STATUS; return true; }
+        if (func == FUNC_CONTROLLER && kbd_mode == PSP2DC_KBD_PAD) { NextPacketSend = SEND_CONTROLLER_STATUS; return true; }
+        return false;
+    case CMD_SET_CONDITION:      // the LEDs: the write format's first byte (FT6 4.1)
+        if (func == FUNC_KEYBOARD && h->NumWords >= 2) {
+            kbd_leds_set = ((const uint8_t *)&data[1])[0];
+            NextPacketSend = SEND_KBD_ACK;
+            return true;
+        }
+        return false;
+    default:
+        return false;
+    }
+}
+
+// From the PSP (psp2dc_host.c): the mode and the 8 bytes; cond NULL lets go
+// of every key (the LEDs kept).
+void dreamcast_set_keyboard(uint8_t mode, const uint8_t *cond)
+{
+    if (mode > PSP2DC_KBD_ONLY) mode = PSP2DC_KBD_OFF;
+    if (cond) memcpy(kbd_cond, cond, sizeof(kbd_cond));
+    else { uint8_t leds = kbd_cond[1]; memset(kbd_cond, 0, sizeof(kbd_cond)); kbd_cond[1] = leds; }
+    if (mode != kbd_mode) {
+        kbd_mode = mode;
+        if (mode) kbd_build();
+        kbd_unplugged_until = (time_us_32() + 1000000) | 1;
+        NextPacketSend = SEND_NOTHING;
+    }
+}
+
+void dreamcast_keyboard_status(uint8_t *mode, uint8_t *leds, uint16_t *reads)
+{
+    *mode = kbd_mode;
+    *leds = kbd_leds_set;
+    *reads = (uint16_t)kbd_reads;
+}
+#endif
+
 // ============================================================================
 // PACKET PROCESSING
 // ============================================================================
@@ -673,6 +847,12 @@ static bool __not_in_flash_func(ConsumePacket)(uint32_t Size)
     // Mask off port number
     uint8_t DestPeripheral = Header->Destination & ADDRESS_PERIPHERAL_MASK;
 
+#ifdef CONFIG_PSP2DC
+    if (kbd_unplugged()) return false;     // the mode changing: nothing there for a moment
+    if (kbd_mode && DestPeripheral == ADDRESS_CONTROLLER) return kbd_consume(Header, PacketData);
+    if (kbd_mode == PSP2DC_KBD_ONLY) return false;   // a keyboard alone has no VMU
+#endif
+
     // Handle main controller requests (address 0x20)
     if (DestPeripheral == ADDRESS_CONTROLLER) {
         switch (Header->Command) {
@@ -998,6 +1178,7 @@ static void __not_in_flash_func(maple_note_unanswered)(uint32_t size)
 {
     const PacketHeader *h = (const PacketHeader *)Packet;
     if (!(h->Destination & ADDRESS_PERIPHERAL_MASK)) return;   // a reply to the Dreamcast: the adapter's own, heard back
+    if (kbd_unplugged_until) return;                           // (the keyboard's mode changing: unanswered on purpose)
     maple_unanswered++;
     maple_last_hdr = (uint32_t)(uint8_t)h->Command | (uint32_t)(h->Destination & ADDRESS_PERIPHERAL_MASK) << 8
                    | (uint32_t)h->NumWords << 16;
@@ -1154,6 +1335,11 @@ static void __no_inline_not_in_flash_func(core1_rx_task)(void)
                         case SEND_PURUPURU_BLOCK_READ:
                             SendPacket((uint32_t *)&PuruPuruBlockReadPacket, sizeof(PuruPuruBlockReadPacket) / sizeof(uint32_t));
                             break;
+#ifdef CONFIG_PSP2DC
+                        case SEND_KBD_INFO: case SEND_KBD_ALL_INFO: case SEND_KBD_STATUS: case SEND_KBD_ACK:
+                            kbd_reply(NextPacketSend);
+                            break;
+#endif
 #ifdef CONFIG_VMU
                         case SEND_VMU_INFO: {
                             uint32_t sz;
@@ -1599,6 +1785,11 @@ void dreamcast_task(void)
             case SEND_PURUPURU_BLOCK_READ:
                 SendPacket((uint32_t *)&PuruPuruBlockReadPacket, sizeof(PuruPuruBlockReadPacket) / sizeof(uint32_t));
                 break;
+#ifdef CONFIG_PSP2DC
+            case SEND_KBD_INFO: case SEND_KBD_ALL_INFO: case SEND_KBD_STATUS: case SEND_KBD_ACK:
+                kbd_reply(NextPacketSend);
+                break;
+#endif
 #ifdef CONFIG_VMU
             case SEND_VMU_INFO: {
                 uint32_t sz;
@@ -1688,6 +1879,11 @@ void dreamcast_task(void)
         case SEND_PURUPURU_BLOCK_READ:
             SendPacket((uint32_t *)&PuruPuruBlockReadPacket, sizeof(PuruPuruBlockReadPacket) / sizeof(uint32_t));
             break;
+#ifdef CONFIG_PSP2DC
+        case SEND_KBD_INFO: case SEND_KBD_ALL_INFO: case SEND_KBD_STATUS: case SEND_KBD_ACK:
+            kbd_reply(NextPacketSend);
+            break;
+#endif
 #ifdef CONFIG_VMU
         case SEND_VMU_INFO: {
             uint32_t sz;
diff --git a/src/native/device/dreamcast/dreamcast_device.h b/src/native/device/dreamcast/dreamcast_device.h
index 219b6291..27cd02f3 100644
--- a/src/native/device/dreamcast/dreamcast_device.h
+++ b/src/native/device/dreamcast/dreamcast_device.h
@@ -181,6 +181,12 @@ bool dreamcast_get_purupuru_state(uint8_t port, uint8_t* power, uint8_t* freq, u
 void dreamcast_enable_vmu(void);
 void dreamcast_disable_vmu(void);
 
+// PSP2DC: the keyboard (dreamcast_device.c, psp2dc_protocol.h's Psp2dcKeyboard).
+// mode PSP2DC_KBD_*; cond the 8 bytes a keyboard answers with, NULL to let
+// go of every key.
+void dreamcast_set_keyboard(uint8_t mode, const uint8_t *cond);
+void dreamcast_keyboard_status(uint8_t *mode, uint8_t *leds, uint16_t *reads);
+
 // OutputInterface accessor
 #include "core/output_interface.h"
 extern const OutputInterface dreamcast_output_interface;
diff --git a/src/usb/usbh/psp2dc/psp2dc_host.c b/src/usb/usbh/psp2dc/psp2dc_host.c
index 3ed54e76..e6e9433e 100644
--- a/src/usb/usbh/psp2dc/psp2dc_host.c
+++ b/src/usb/usbh/psp2dc/psp2dc_host.c
@@ -85,6 +85,18 @@ static bool card_loaded;
 static char card_name[PSP2DC_CARD_NAME_LEN];   // the card's name, as the PSP gave it
 bool psp2dc_card_ready(void) { return card_loaded; }
 
+// The keyboard (dreamcast_device.c): its mode stays when the PSP goes quiet
+// or away, so that the Dreamcast is not shown another device; its keys go.
+extern void dreamcast_set_keyboard(uint8_t mode, const uint8_t *cond);
+extern void dreamcast_keyboard_status(uint8_t *mode, uint8_t *leds, uint16_t *reads);
+static void keys_let_go(void)
+{
+    uint8_t mode, leds;
+    uint16_t reads;
+    dreamcast_keyboard_status(&mode, &leds, &reads);
+    dreamcast_set_keyboard(mode, NULL);
+}
+
 #ifdef CONFIG_VMU
 // The card's CRC-32, a part at a time (the Dreamcast may write meanwhile: a
 // CRC that matches no copy only makes the PSP keep both).
@@ -160,6 +172,10 @@ static void message(uint8_t addr, psp2dc_dev_t *d, uint8_t type, const uint8_t *
         d->inputs++;
         d->input_ms = platform_time_ms();
         d->silent = false;
+    } else if (type == PSP2DC_MSG_KEYBOARD && len == sizeof(Psp2dcKeyboard)) {
+        Psp2dcKeyboard k;
+        memcpy(&k, payload, sizeof(k));
+        dreamcast_set_keyboard(k.mode, k.cond);
     } else if (type == PSP2DC_MSG_HELLO && len >= 1) {
         printf("[psp2dc] PSP %u: hello, protocol %u\n", addr, payload[0]);
         d->state_due = true;
@@ -290,6 +306,7 @@ static uint16_t next_out(psp2dc_dev_t *d, uint32_t now)
             st.maple_slow = (uint16_t)m[6];
             st.maple_max_us = m[7] > 0xffff ? 0xffff : (uint16_t)m[7];
         }
+        dreamcast_keyboard_status(&st.kbd_mode, &st.kbd_leds, &st.kbd_reads);
 #endif
         d->status_ms = now;
         return put_msg(d->tx, PSP2DC_MSG_STATUS, &st, sizeof(st));
@@ -321,6 +338,7 @@ void psp2dc_host_task(void)
 
     if (d->state == ST_RUNNING && d->submitted && !d->silent && now - d->input_ms > PSP2DC_SILENCE_MS) {
         submit(d->addr, d, NULL);   // the PSP went quiet: let go of everything
+        keys_let_go();
         d->silent = true;
     }
     if (d->busy) return;
@@ -361,6 +379,7 @@ static void psp2dc_close(uint8_t addr)
     psp2dc_dev_t *d = dev(addr);
     if (!d) return;
     if (d->submitted) router_device_disconnected(addr, 0);
+    keys_let_go();
     printf("[psp2dc] PSP %u: gone (%lu inputs, %lu bad bytes)\n", addr,
            (unsigned long)d->inputs, (unsigned long)d->bad);
     memset(d, 0, sizeof(*d));
