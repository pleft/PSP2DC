From 389a6c3e62e7e36cf52f7f7dbef76e3d4921ac58 Mon Sep 17 00:00:00 2001
From: pleft <elefasgr@gmail.com>
Date: Sun, 15 Nov 2026 16:10:44 +0200
Subject: [PATCH 02/16] usb2dc_superpico: memory card in RAM only, Bluetooth
 removed (experimental)

CONFIG_VMU on this target with no storage backend: the Dreamcast sees a
formatted card that lasts until power off, and nothing is written to flash
(the writes are what disturbed Maple timing upstream). BTstack is dropped from
the target to make room for the 128 KB image; about 250 KB of RAM is used.

Builds; not yet flashed or tested.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/CMakeLists.txt | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index b5a18757..5cfd57c4 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -817,6 +817,7 @@ add_executable(joypad_dc_superpico)
 target_compile_definitions(joypad_dc_superpico PRIVATE
     MAPLE_PIN1=21 MAPLE_PIN5=22
     CONFIG_PSP2DC=1               # host driver for a PSP running PSP2DC
+    CONFIG_VMU=1                  # memory card, RAM only: no backend, so no flash writes (lost at power off)
     CONFIG_NO_NEOPIXEL=1          # no pixel; default pins would hit a buffer
     USE_BOOTSEL_BUTTON=1          # no GPIO button (buffered pins read garbage)
     BOARD_LED_PIN=25
@@ -845,7 +846,8 @@ target_link_libraries(joypad_dc_superpico PRIVATE ${COMMON_LIBRARIES} hardware_d
 pico_enable_stdio_uart(joypad_dc_superpico 1)
 pico_enable_stdio_usb(joypad_dc_superpico 0)
 joypad_target_common(joypad_dc_superpico)
-joypad_add_btstack(joypad_dc_superpico)
+# No Bluetooth (no joypad_add_btstack): the USB port is the PSP's, and BTstack's
+# RAM is what the 128 KB memory card image needs.
 pico_generate_pio_header(joypad_dc_superpico ${CMAKE_CURRENT_LIST_DIR}/native/device/dreamcast/maple.pio)
 
